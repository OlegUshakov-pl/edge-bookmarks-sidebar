{
  "manifest_version": 3,
  "name": "Simple Bookmarks Sidebar",
  "version": "2.1.0",
  "description": "Bookmarks side panel that opens on icon click and works on every tab, including edge://newtab and empty pages",
  "permissions": [
    "bookmarks",
    "tabs",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open bookmarks sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}