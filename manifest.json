{
  "manifest_version": 3,
  "name": "Простая панель закладок",
  "version": "1.0.0",
  "description": "Минималистичная боковая панель с закладками для Microsoft Edge",
  "permissions": [
    "sidePanel",
    "bookmarks",
    "tabs",
    "storage"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Открыть панель закладок",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
